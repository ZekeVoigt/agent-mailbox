{
	# no admin endpoint; the certificate and its key are made here and kept on the tmpfs
	admin off
	storage file_system {$VAULT_DATA}/caddy
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

{$VAULT_HOST} {
	# every response, keeper's and redirects too, keeps the app's own headers or gets these
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "no-referrer"
	}
	# no page here uses a camera, microphone, location, payment or USB device (its own directive: the
	# block above is skipped for a response that already carries the app's headers)
	header ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	# no body is buffered past what its route needs: an upload's 90 MB video, 2 MB for anything else
	@upload path /home/media
	request_body @upload {
		max_size 95MB
	}
	@other not path /home/media
	request_body @other {
		max_size 2MB
	}
	# Google's attestation for this image and the certificates it made, from keeper (only these paths)
	@attest path /attestation /attestation/certs
	handle @attest {
		reverse_proxy 127.0.0.1:8081
	}
	# the owner's restore swaps the directory under workerd, so keeper answers it
	handle /admin/restore {
		reverse_proxy 127.0.0.1:8081 {
			header_up cf-connecting-ip {remote_host}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			# the caller's address, set here so a client cannot supply its own
			header_up cf-connecting-ip {remote_host}
			header_up -x-vault-internal
			flush_interval -1
		}
	}
}
