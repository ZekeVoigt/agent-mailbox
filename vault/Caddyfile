{
	# no admin endpoint; the certificate and its key are made here and kept on the tmpfs
	admin off
	storage file_system {$VAULT_DATA}/caddy
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

{$VAULT_HOST} {
	# Google's attestation for this image and the certificates it made, from keeper (only these paths)
	@attest path /attestation /attestation/certs
	handle @attest {
		reverse_proxy 127.0.0.1:8081
	}
	# the owner's restore swaps the directory under workerd, so keeper answers it
	handle /admin/restore {
		reverse_proxy 127.0.0.1:8081 {
			header_up cf-connecting-ip {remote_host}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			# the caller's address, set here so a client cannot supply its own
			header_up cf-connecting-ip {remote_host}
			header_up -x-vault-internal
			flush_interval -1
		}
	}
}
